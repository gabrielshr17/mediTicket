DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Stripe test-mode keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen --forward-to localhost:3000/api/webhook`
STRIPE_WEBHOOK_SECRET="whsec_..."

# Shared secret the chatbot backend must send as `Authorization: Bearer <value>`
# when calling POST/GET/DELETE /api/mcp. Generate with e.g. `openssl rand -hex 32`.
MCP_API_KEY="change-me"

# Powers the in-app chat widget (POST /api/chat). Without this set, the widget
# shows an "unavailable" state instead of erroring. https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
# Optional: override the model used by the chat widget (defaults to gpt-5.6-luna).
# OPENAI_MODEL="gpt-5.6-luna"

# Abuse limits for the chat endpoint (optional; defaults shown).
# CHAT_RATE_LIMIT_PER_MINUTE="10"
# CHAT_RATE_LIMIT_PER_DAY="60"
# CHAT_RATE_LIMIT_GLOBAL_PER_DAY="500"
# CHAT_RATE_LIMIT_MAX_CLIENTS="10000"

# Extra origins allowed to call /api/chat and /api/checkout, comma separated.
# The site's own origin is always allowed; set this only to embed the widget elsewhere.
# ALLOWED_ORIGINS="https://partner.example.com"

# Redis for the BullMQ email queue (defaults to a local Redis).
# REDIS_URL="redis://127.0.0.1:6379"
# BULL_BOARD_PORT="3001"

# SMTP for booking confirmation emails. With none set, mail is logged
# instead of sent (nodemailer jsonTransport), which is fine for development.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="mediTicket <no-reply@mediticket.example>"
