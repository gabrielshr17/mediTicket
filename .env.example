DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Stripe test-mode keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen --forward-to localhost:3000/api/webhook`
STRIPE_WEBHOOK_SECRET="whsec_..."

# Shared secret the chatbot backend must send as `Authorization: Bearer <value>`
# when calling POST/GET/DELETE /api/mcp. Generate with e.g. `openssl rand -hex 32`.
MCP_API_KEY="change-me"

# Powers the in-app chat widget (POST /api/chat). Without this set, the widget
# shows an "unavailable" state instead of erroring. https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
# Optional: override the model used by the chat widget (defaults to gpt-5.6-luna).
# OPENAI_MODEL="gpt-5.6-luna"
